  "word_note_replacements": [
    {
      "word_id": "G4532_0000",
      "before": null,
      "after": "히브리어 지명 살렘(H8004)의 헬라어 표기다. 살렘은 한국어 성경의 관용 표기이며, 샬렘은 원천 히브리어 이름의 분석 표기다. 샬렘을 헬라어 표제어의 실제 발음으로 제시하는 것은 아니다. 히브리서 7:2는 이 이름을 평화와 연결하여 풀이한다."
    },
    {
      "word_id": "G4539_0000",
      "before": null,
      "after": "마가복음 15:40·16:1에 나오는 여인의 이름이다. 히브리어 평안 계열에서 유래했을 가능성이 있지만, 이 이름의 실제 히브리어·아람어 원형과 발음은 확정되지 않았다."
    },
    {
      "word_id": "G4672_0000",
      "before": null,
      "after": "히브리어 인명 솔로몬(H8010)의 헬라어 표기다. 솔로몬은 한국어 성경의 관용 표기이며, 셸로모는 원천 히브리어 이름의 분석 표기다. 어두 셰와의 한글 근사인 셸을 특정 시대의 실제 발음으로 확정하거나, 셸로모를 헬라어 표제어의 실제 발음으로 제시하지 않는다."
    },
    {
      "word_id": "H0053_0000",
      "before": null,
      "after": "아버지(H1)와 평안(H7965) 계열의 합성 인명이다. 압살롬은 단축형, 아비살롬은 완전형에 대응한다. 열왕기상 15장의 아비살롬과 다윗의 아들 압살롬의 인물 동일성은 이름 자체만으로 확정하지 않는다."
    },
    {
      "word_id": "H3073_0000",
      "before": null,
      "after": "기드온이 제단에 붙인 이름으로, ‘여호와는 평안이시다’라는 뜻이다. ‘여호와’는 한국어 성경의 관용 표기이며, 히브리어 신명의 고대 발음을 확정한 표기는 아니다."
    },
    {
      "word_id": "H4918_0000",
      "before": null,
      "after": "메슐람는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘메’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H4919_0000",
      "before": null,
      "after": "므실레밋(H4921)과 비교되는 이름이지만, 같은 인물로 확정하지 않는다. 메쉴레모트는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘메’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H4920_0000",
      "before": null,
      "after": "H7999 계열과 야(H3050)가 결합된 인명이다. 야·야후 두 어말형이 쓰인다. 메셸렘-야·메셸렘-야후는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘메’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H4921_0000",
      "before": null,
      "after": "무실레못·므실레못(H4919)과 비교되는 이름이지만, 같은 인물로 확정하지 않는다. 메쉴레미트는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘메’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H4922_0000",
      "before": null,
      "after": "메슐레메트는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘메’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H7759_0000",
      "before": null,
      "after": "아가 7:1(많은 번역의 6:13)에서 여인을 부르고 지칭하는 표현이다. 출신을 나타내는 명칭인지 별칭인지, 정확한 유래와 뜻은 확정되지 않았다."
    },
    {
      "word_id": "H7965_0000",
      "before": null,
      "after": "건강·안전·안녕·형통을 아우르는 평안과, 적대가 없는 관계·화친·친목을 뜻한다. 온전함은 예레미야 13:19의 드문 용례에 근거하며, 이 구절의 본문 독법에는 이견이 있다."
    },
    {
      "word_id": "H7966_0000",
      "before": null,
      "after": "행위에 상응하는 갚음을 가리킨다. 호세아 9:7과 이사야 34:8에서는 부정적 행위에 대한 갚음이며, 미가 7:3에서는 재판과 관련하여 요구하는 뇌물이다. 좋은 행위에 주는 상으로만 한정하지 않는다."
    },
    {
      "word_id": "H7968_0000",
      "before": null,
      "after": "느헤미야 3:15의 인명이다. 살룸(H7967)의 이형일 가능성이 있으나 확정하지 않는다."
    },
    {
      "word_id": "H7999_0000",
      "before": null,
      "after": "갚다는 손해를 배상하거나 행위에 보응하고, 서원·약속을 이행하거나 잃은 것을 되돌려 주는 문맥까지 포함한다. 완료·평안·화목은 사역형을 포함하며, 이사야 42:19의 분사 해석에는 이견이 있다."
    },
    {
      "word_id": "H8000_0000",
      "before": null,
      "after": "아람어 동사로, 완료·종결을 나타내며 에스라 7:19에서는 그릇들을 하나님 앞에 넘겨주는 행위를 가리킨다."
    },
    {
      "word_id": "H8001_0000",
      "before": null,
      "after": "아람어로, 편지와 왕의 조서에서 안녕을 비는 인사말에 쓰인다."
    },
    {
      "word_id": "H8002_0000",
      "before": null,
      "after": "감사제(感謝祭)를 포함하며, 서원하거나 자원하여 드리는 경우도 있는 제사이다. 그 제물도 가리킨다."
    },
    {
      "word_id": "H8004_0000",
      "before": null,
      "after": "창세기 14:18과 시편 76:3의 지명이다. 창세기 33:18의 동형 표현은 현재 canonical source에서 H8003로 분류되며, 지명과 형용사 해석이 갈린다."
    },
    {
      "word_id": "H8005_0000",
      "before": null,
      "after": "행위에 상응하는 갚음을 가리킨다. 유일한 용례인 신명기 32:35에서는 악에 대한 갚음이며, 복수만을 뜻하는 말로 한정하지 않는다."
    },
    {
      "word_id": "H8010_0000",
      "before": null,
      "after": "평안(H7965) 계열의 인명이다. 시편 표제와 아가의 이름 사용도 포함되며, 저자·연대는 어휘 의미로 확정하지 않는다. 셸로모는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘셸’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H8011_0000",
      "before": null,
      "after": "행위에 상응하는 갚음을 가리킨다. 시편 91:8에서는 악인이 자기 행위에 따라 받는 갚음이다."
    },
    {
      "word_id": "H8013_0000",
      "before": null,
      "after": "역대상 일부 용례에는 슬로못 계열의 케티브와 슬로밋 계열의 케레가 함께 있다. 이 철자·읽기 차이는 인물 동일성을 자동 확정하는 근거가 아니다. 셸로모트·셸로미트는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘셸’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H8015_0000",
      "before": null,
      "after": "셸로미는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘셸’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H8017_0000",
      "before": null,
      "after": "평안(H7965) 계열과 엘(H410)이 결합된 인명이다. 셸루미-엘는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘셸’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H8018_0000",
      "before": null,
      "after": "canonical lexical source는 화목제(H8002)와 야(H3050)가 결합된 이름으로 설명한다. 야·야후 두 어말형이 쓰인다."
    },
    {
      "word_id": "H8019_0000",
      "before": null,
      "after": "남녀에게 모두 쓰이는 이름이다. 일부 용례는 슬로못 계열의 표기·읽기 및 한국어 관용 표기와 겹치며, H8013과의 인물 동일성을 일괄 확정하지 않는다. 셸로미트는 원문과 사전 전사를 대조하기 위한 분석 표기다. 어두 ‘셸’는 셰와의 한글 근사이며 특정 시대의 실제 발음을 확정하지 않는다."
    },
    {
      "word_id": "H8021_0000",
      "before": null,
      "after": "어떤 행위나 호의의 대가로 주는 사례물을 가리킨다. 유일한 용례인 이사야 1:23에서는 부패한 지도자들이 추구하는 부당한 사례물, 곧 뇌물이다."
    }
  ],
